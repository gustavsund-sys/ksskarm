rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/screenAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/screenAdmins/$(request.auth.uid)).data.enabled == true;
    }
    function validCommon(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 240
        && d.description is string && d.description.size() <= 600
        && (!('eventType' in d) || (d.eventType is string && d.eventType.size() > 0 && d.eventType.size() <= 40))
        && d.hidden is bool
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }
    match /screenAdmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /concertEdits/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && id.matches('konsertsal:.*')
        && request.resource.data.keys().hasOnly(['title', 'eventType', 'description', 'hidden', 'sourceTitle', 'updatedAt', 'updatedBy'])
        && validCommon(request.resource.data)
        && request.resource.data.sourceTitle is string
        && request.resource.data.sourceTitle.size() <= 10000;
      allow delete: if isAdmin();
    }
    match /manualConcerts/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && id.matches('manual:.*')
        && request.resource.data.keys().hasOnly(['title', 'eventType', 'description', 'hidden', 'start', 'end', 'updatedAt', 'updatedBy'])
        && validCommon(request.resource.data)
        && request.resource.data.start is timestamp
        && request.resource.data.end is timestamp
        && request.resource.data.end > request.resource.data.start
        && request.resource.data.end - request.resource.data.start <= duration.value(24, 'h');
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
